PORT=4000
DATABASE_URL="file:./dev.db"
DSP_API_URL="http://localhost:3000/v1"
DSP_API_KEY="dsp_live_marketplace_bolivia_2026"
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:5173"
# Product and QR photos. In Railway point it at the volume so photos survive redeploys: /data/uploads
UPLOAD_DIR=

# TikTok LIVE discovery: explicitly enable network jobs after configuring Redis/browser.
TIKTOK_LIVES_ENABLED=false
TIKTOK_REDIS_URL=redis://127.0.0.1:6379/1
TIKTOK_ADMIN_KEY=
TIKTOK_COUNTRY_CODE=BO
TIKTOK_REGION_TERMS=bolivia,scz,santa cruz,la paz,cochabamba,el alto,tarija,sucre,oruro,potosi,beni,pando
# false: list selling lives even without regional evidence (explicit foreign countries are still excluded).
TIKTOK_REQUIRE_REGION=false
# Keywords explored through TikTok LIVE search, besides the /live recommendations feed.
TIKTOK_SEARCH_TERMS=venta de ropa,remate de ropa,ofertas en vivo,tienda bolivia,ropa americana,fardos,liquidacion,ropa santa cruz,ropa la paz,ropa cochabamba,ropa el alto,zapatos,carteras,maquillaje,perfumes,juguetes,celulares,cosas de hogar,tupperware,accesorios mujer,ropa de bebe,lenceria,fajas,ofertas bolivia
# Terms explored per cycle; the rest rotate in on following cycles.
TIKTOK_SEARCH_TERMS_PER_CYCLE=4
# Concurrent HTTP verifications of active lives (raise if many lives expire before re-verification).
TIKTOK_VERIFY_CONCURRENCY=5
# Ended sellers re-probed every 3 min to catch them going live again (0 disables). Each one is an HTTP request to TikTok.
TIKTOK_RECHECK_PER_CYCLE=15
# Live sellers whose rooms are visited per discovery cycle to collect related LIVEs (0 disables).
TIKTOK_SNOWBALL_PER_CYCLE=3
TIKTOK_HEADLESS=true
TIKTOK_SCROLL_STEPS=20
TIKTOK_MAX_CANDIDATES=200
TIKTOK_MAX_CONNECTIONS=10
# Use a provider-issued residential HTTP(S) proxy; region selection is provider-specific.
TIKTOK_PROXY_URL=
# Optional Euler Stream signing key for WebSocket connections (no session cookies forwarded).
TIKTOK_SIGN_API_KEY=
# Leave blank to use Puppeteer's installed browser; Docker sets /usr/bin/chromium-browser.
PUPPETEER_EXECUTABLE_PATH=
# Perfil persistente de Chromium donde queda la sesión de TikTok del operador (no subir a git).
TIKTOK_PROFILE_DIR=.tiktok-profile
# true solo en el equipo del operador: permite abrir la ventana "Iniciar sesión con TikTok" desde /live.
TIKTOK_INTERACTIVE_LOGIN=false
