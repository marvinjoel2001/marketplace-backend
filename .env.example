PORT=4000
DATABASE_URL="file:./dev.db"
DSP_API_URL="http://localhost:3000/v1"
DSP_API_KEY="dsp_live_marketplace_bolivia_2026"
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:5173"

# TikTok LIVE discovery: explicitly enable network jobs after configuring Redis/browser.
TIKTOK_LIVES_ENABLED=false
TIKTOK_REDIS_URL=redis://127.0.0.1:6379/1
TIKTOK_ADMIN_KEY=
TIKTOK_COUNTRY_CODE=BO
TIKTOK_REGION_TERMS=bolivia,scz,santa cruz,la paz,cochabamba,el alto,tarija,sucre,oruro,potosi,beni,pando
TIKTOK_HEADLESS=true
TIKTOK_SCROLL_STEPS=8
TIKTOK_MAX_CANDIDATES=40
TIKTOK_MAX_CONNECTIONS=10
# Use a provider-issued residential HTTP(S) proxy; region selection is provider-specific.
TIKTOK_PROXY_URL=
# Optional Euler Stream signing key for WebSocket connections (no session cookies forwarded).
TIKTOK_SIGN_API_KEY=
# Leave blank to use Puppeteer's installed browser; Docker sets /usr/bin/chromium-browser.
PUPPETEER_EXECUTABLE_PATH=
