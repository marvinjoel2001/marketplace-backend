# Backend del marketplace (incluye /api/v1, sin barra final)
MARKETPLACE_API_URL=http://localhost:4000/api/v1
# Web pública, para devolver enlaces de compra (/product/<slug>)
MARKETPLACE_WEB_URL=https://tu-dominio.com
PORT=4100

# --- Cuentas (comprar y vender). Sin estas dos variables el MCP queda en solo lectura ---
# URL pública HTTPS de ESTE servidor (sin /mcp)
MCP_PUBLIC_URL=https://tu-mcp.up.railway.app
# Secreto para firmar sesiones, 32+ caracteres al azar:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_SECRET=
# Debe ser EXACTAMENTE la misma AUTH_INTERNAL_KEY del backend
AUTH_INTERNAL_KEY=
