{
  "name": "vitrina-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Servidor MCP de Vitrina Market: deja que Claude, ChatGPT o Gemini busquen productos, tiendas y lives.",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p .",
    "start": "node dist/http.js",
    "start:stdio": "node dist/stdio.js",
    "dev": "tsx src/http.ts",
    "test": "node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^4.21.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
